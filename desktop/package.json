{
  "name": "openticket-desktop",
  "version": "0.3.3",
  "description": "OpenTicket - self-contained ticket management for desktop",
  "main": "dist/main.js",
  "homepage": "./",
  "private": true,
  "author": "Your Company",
  "scripts": {
    "dev": "tsc && electron .",
    "dev:backend": "cd ../backend && npm run dev",
    "dev:frontend": "cd ../frontend && cross-env PORT=3001 npm run dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "build:backend": "cd ../backend && npm run build",
    "build:frontend": "cd ../frontend && npm run build",
    "build:electron": "tsc",
    "electron": "electron .",
    "electron-dev": "tsc && electron . --dev",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "prepack": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.openticket.app",
    "productName": "OpenTicket",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../frontend/out",
        "to": "frontend/out"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "OpenTicket-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 360,
          "type": "file",
          "path": "assets/Uninstall OpenTicket.command"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "OpenTicket-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "OpenTicket-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "damianx9x",
        "repo": "OpenTicket"
      }
    ]
  }
}
