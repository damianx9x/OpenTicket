generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  // Supports both PostgreSQL and SQLite via DATABASE_URL
  // Desktop (SQLite): file:./data/app.db
  // Web (Postgres): postgresql://user:pass@host/db
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support native enums, using String instead
// Values: ADMIN, AGENT, REPORTER, VIEWER
// Values: NEW, IN_PROGRESS, WAITING_FOR_CUSTOMER, RESOLVED, CLOSED, ARCHIVED
// Values: LOW, NORMAL, HIGH, URGENT
// Values: APP, WEB_FORM, EMAIL, DROP_OFF

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  role        String    @default("REPORTER")  // ADMIN, AGENT, REPORTER, VIEWER
  phone       String?   @map("phone")
  passwordHash String?  @map("password_hash")
  uiPreferences String? @map("ui_preferences") // JSON string with dashboard/layout/profile settings
  createdAt   DateTime  @default(now()) @map("created_at")
  disabledAt  DateTime? @map("disabled_at")

  ticketsOwned    Ticket[]              @relation("TicketOwner")
  ticketsAssigned Ticket[]              @relation("TicketAssignee")
  statusChanges   TicketStatusHistory[]
  comments        Comment[]
  attachments     Attachment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  authSessions    AuthSession[]
  notesReceived   UserNote[]            @relation("TargetUserNotes")
  notesAuthored   UserNote[]            @relation("AuthorUserNotes")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  nip       String?
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("organizations")
}

model Ticket {
  id              String    @id @default(uuid())
  number          Int       @unique  // Will be set manually by backend (e.g., timestamp or counter)
  title           String
  description     String
  status          String    @default("NEW")  // NEW, IN_PROGRESS, WAITING_FOR_CUSTOMER, RESOLVED, CLOSED, ARCHIVED
  priority        String    @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  channel         String    @default("WEB_FORM")  // APP, WEB_FORM, EMAIL, DROP_OFF

  ownerUserId     String         @map("owner_user_id")
  owner           User           @relation("TicketOwner", fields: [ownerUserId], references: [id])

  assignedAgentId String?        @map("assigned_agent_id")
  assignedAgent   User?          @relation("TicketAssignee", fields: [assignedAgentId], references: [id])

  organizationId  String?        @map("organization_id")
  organization    Organization?  @relation(fields: [organizationId], references: [id])

  publicToken     String?        @unique @map("public_token")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  closedAt        DateTime?      @map("closed_at")

  statusHistory TicketStatusHistory[]
  comments      Comment[]
  attachments   Attachment[]
  costItems     CostItem[]
  notifications Notification[]

  @@index([status, priority, updatedAt])
  @@map("tickets")
}

model TicketStatusHistory {
  id         String    @id @default(uuid())
  ticketId   String    @map("ticket_id")
  ticket     Ticket    @relation(fields: [ticketId], references: [id])

  fromStatus String    @map("from_status")  // NEW, IN_PROGRESS, etc
  toStatus   String    @map("to_status")  // NEW, IN_PROGRESS, etc

  changedBy  String       @map("changed_by")
  user       User         @relation(fields: [changedBy], references: [id])

  changedAt  DateTime     @default(now()) @map("changed_at")

  @@map("ticket_status_history")
}

model Comment {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  ticket       Ticket   @relation(fields: [ticketId], references: [id])

  authorUserId String   @map("author_user_id")
  author       User     @relation(fields: [authorUserId], references: [id])

  body         String
  isInternal   Boolean  @default(false) @map("is_internal")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("comments")
}

model Attachment {
  id              String   @id @default(uuid())
  ticketId        String   @map("ticket_id")
  ticket          Ticket   @relation(fields: [ticketId], references: [id])

  uploadedBy      String?  @map("uploaded_by")
  uploader        User?    @relation(fields: [uploadedBy], references: [id])

  filename        String
  mimeType        String   @map("mime_type")
  byteSize        BigInt   @map("byte_size")
  storageProvider String   @map("storage_provider")
  bucket          String
  objectKey       String   @map("object_key")
  sha256          String?

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("attachments")
}

model VatRate {
  code     String  @id
  percent  Decimal @map("percent")
  isExempt Boolean @default(false) @map("is_exempt")
  name     String

  costItems CostItem[]

  @@map("vat_rates")
}

model CostItem {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id])

  name       String
  qty        Decimal  @map("qty")
  unitNet    Decimal  @map("unit_net")

  vatCode    String   @map("vat_code")
  vatRate    VatRate  @relation(fields: [vatCode], references: [code])

  netTotal   Decimal  @map("net_total")
  vatTotal   Decimal  @map("vat_total")
  grossTotal Decimal  @map("gross_total")

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cost_items")
}

model AutomationRule {
  id         String    @id @default(uuid())
  name       String
  enabled    Boolean   @default(true)
  trigger    String
  conditions String    @map("conditions")  // JSON as string
  actions    String    @map("actions")  // JSON as string

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("automation_rules")
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  channel   String

  ticketId  String?   @map("ticket_id")
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])

  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id])

  payload   String    @map("payload")  // JSON as string
  status    String
  error     String?

  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?   @map("actor_user_id")
  actor       User?     @relation(fields: [actorUserId], references: [id])

  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    String?   @map("metadata")  // JSON as string
  ip          String?  @map("ip")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model UserNote {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  targetUser   User     @relation("TargetUserNotes", fields: [userId], references: [id])
  authorUserId String?  @map("author_user_id")
  authorUser   User?    @relation("AuthorUserNotes", fields: [authorUserId], references: [id])
  body         String
  isInternal   Boolean  @default(true) @map("is_internal")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("user_notes")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
